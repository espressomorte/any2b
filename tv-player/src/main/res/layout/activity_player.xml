<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Відеоповерхня: контролами керує окремий TV-friendly шар нижче. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/playerLoadingLogo"
            android:layout_width="300dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            android:contentDescription="Логотип тайтлу"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </FrameLayout>

    <ua.any2b.tvplayer.ui.PlayerControlsView
        android:id="@+id/playerControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:background="#B8000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnSkipIntro"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="160dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="ПРОПУСТИТИ ІНТРО"
        android:textAllCaps="false"
        android:textColor="#01010A"
        android:textSize="14sp"
        android:fontFamily="@font/ibm_plex_sans_regular"
        android:backgroundTint="#1CDDE2"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/playerControls"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="20dp" />

    <!-- Оверлей зі статусом завантаження / кнопкою наступної серії -->
    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#88000000"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Завантаження потоку…"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:maxWidth="600dp"
            android:ellipsize="middle"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnNextEpisode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ Наступна серія"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:textColor="#21005D"
            android:backgroundTint="#D0BCFF"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
