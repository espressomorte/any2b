<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/nowPlayingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNowPlaying"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="600dp"
                android:ellipsize="end"
                android:fontFamily="@font/ibm_plex_sans_regular"
                android:singleLine="true"
                android:textColor="#80F5FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextEpisodeControl"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:clickable="true"
                android:contentDescription="Перейти до наступної серії"
                android:drawableStart="@drawable/ic_player_next_episode"
                android:drawablePadding="8dp"
                android:drawableTint="@color/player_next_episode_tint"
                android:focusable="true"
                android:fontFamily="@font/ibm_plex_sans_regular"
                android:gravity="center_vertical"
                android:nextFocusDown="@id/playbackSeekBar"
                android:textColor="@color/player_next_episode_tint"
                android:textSize="14sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/playerTrackActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnAudioTracks"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/player_track_action_compact_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:visibility="gone"
                    android:nextFocusDown="@id/playbackSeekBar">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/fa_solid_900"
                        android:text="&#xf130;"
                        android:textColor="@color/player_track_action_text"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvAudioTrackChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/ibm_plex_sans_regular"
                        android:text="Авто"
                        android:textColor="@color/player_track_action_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSubtitleTracks"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/player_track_action_compact_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:visibility="gone"
                    android:nextFocusDown="@id/playbackSeekBar">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/fa_solid_900"
                        android:text="&#xf4ad;"
                        android:textColor="@color/player_track_action_text"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvSubtitleTrackChoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/ibm_plex_sans_regular"
                        android:text="—"
                        android:textColor="@color/player_track_action_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPlaybackPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/playbackSeekBar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:contentDescription="Позиція відтворення"
            android:focusable="true"
            android:progressBackgroundTint="#0D5B70"
            android:secondaryProgressTint="#93B3BF"
            android:progressTint="#1CDDE2"
            android:thumbTint="#80F5FF" />

        <TextView
            android:id="@+id/tvPlaybackDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:gravity="end"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>

</merge>
