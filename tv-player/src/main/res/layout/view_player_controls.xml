<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:singleLine="true"
            android:textColor="#80F5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPlaybackPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/playbackSeekBar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:contentDescription="Позиція відтворення"
            android:focusable="true"
            android:progressBackgroundTint="#0D5B70"
            android:secondaryProgressTint="#0D5B70"
            android:progressTint="#1CDDE2"
            android:thumbTint="#80F5FF" />

        <TextView
            android:id="@+id/tvPlaybackDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:gravity="end"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerTrackActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnAudioTracks"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/player_track_action_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/ibm_plex_sans_regular"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="♫ АУДІО"
                android:textColor="#C4CAD4"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSubtitleTracks"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/player_track_action_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/ibm_plex_sans_regular"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="CC СУБТИТРИ"
                android:textColor="#C4CAD4"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</merge>
