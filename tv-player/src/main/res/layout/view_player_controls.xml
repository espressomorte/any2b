<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:singleLine="true"
            android:textColor="#80F5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPlaybackPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/playbackSeekBar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:contentDescription="Позиція відтворення"
            android:focusable="true"
            android:progressBackgroundTint="#0D5B70"
            android:secondaryProgressTint="#0D5B70"
            android:progressTint="#1CDDE2"
            android:thumbTint="#80F5FF" />

        <TextView
            android:id="@+id/tvPlaybackDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:gravity="end"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</merge>
